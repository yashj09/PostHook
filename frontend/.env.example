# Posthook frontend — environment template.
# Copy to .env.local for local dev, or set these in the Vercel project settings.
#
# NOTE: every NEXT_PUBLIC_* var is inlined at BUILD time. Changing one on a
# deployed app requires a redeploy, not just an env edit.

# ── Wallet ────────────────────────────────────────────────────────────────
# Required in production. Create one at https://cloud.reown.com (WalletConnect).
# The code falls back to "posthook-dev" locally, which will NOT work in prod.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Sorting room mode ───────────────────────────────────────────────────────
# "log" (default): tail the local relayer log file via SSE — for local dev with
#   `bash contracts/relayer/relay.sh` running.
# "rpc": derive the live ledger from on-chain events via getLogs — use this on
#   Vercel, where there is no local relayer log file.
NEXT_PUBLIC_SORTINGROOM_MODE=log

# Server-side: where the SSE route tails the relayer log (local "log" mode only).
RELAYER_LOG_PATH=/tmp/posthook-relay.log

# ── Pinned demo gift (the landing "Try the demo" CTA) ───────────────────────
# A real in-transit gift on the live contracts. If unset, the code uses the
# baked-in defaults in src/lib/demo.ts. If invalid/missing, the CTA hides.
NEXT_PUBLIC_DEMO_GIFT_ID=0xfedf09a276a648f99481386a566c47ee8e263d61418ffb36bbf1992e3a96779b
NEXT_PUBLIC_DEMO_SECRET=Postcard-Heath-Ember-Cobalt

# ── RPC endpoints (optional overrides) ──────────────────────────────────────
# Defaults are the public testnet RPCs (may rate-limit under load). Override
# with a paid endpoint (Alchemy/Infura) if the deployed app gets traffic.
NEXT_PUBLIC_UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Contract address overrides (optional) ───────────────────────────────────
# src/lib/contracts.ts already defaults to the current deployment, so these are
# only needed if you redeploy. Addresses are EIP-55 checksum-normalized in code.
NEXT_PUBLIC_UNICHAIN_SEPOLIA_POOL_MANAGER=0x00B036B58a818B1BC34d502D3fE730Db729e62AC
NEXT_PUBLIC_UNICHAIN_SEPOLIA_POSITION_MANAGER=0xf969Aee60879C54bAAed9F3eD26147Db216Fd664
NEXT_PUBLIC_UNICHAIN_SEPOLIA_GIFT_SENDER=0xe51ccEb811b78b0d4d4592fF82422680d0959EaD
NEXT_PUBLIC_UNICHAIN_SEPOLIA_HOOK=0xdBaE3F68d81580eF851aF7d7EA9d26C8EE2a5ac0
NEXT_PUBLIC_UNICHAIN_SEPOLIA_USDC=0x31d0220469e10c4E71834a79b1f276d740d3768F
NEXT_PUBLIC_UNICHAIN_SEPOLIA_USDT=0x7FDF67698D0A83EB97eA770D9bcA66d3557556c0
NEXT_PUBLIC_BASE_SEPOLIA_GIFT_RECIPIENT=0x6C5E1FE9eDa67BE07f80582C1e4488ad416bF5C2
NEXT_PUBLIC_BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
